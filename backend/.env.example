# ATS Skill Certification - Backend Environment Configuration

# MongoDB Atlas Connection URI
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/ats_skill_certification?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/ats_skill_certification
MONGODB_DATABASE=ats_skill_certification

# JWT Authentication Secret (Must be 32+ characters / 256 bits for HMAC-SHA256)
JWT_SECRET=atsSkillCertificationSuperSecretKeyMustBeAtLeast256BitsLongForHmacSha256Security2026!
JWT_EXPIRATION_MS=86400000

# Client Application URL for CORS & QR Verification URL generation
FRONTEND_URL=http://localhost:5173
PUBLIC_APP_URL=http://localhost:5173

# Initial Bootstrap Administrator Credentials (Created on first startup if not existing)
ADMIN_EMAIL=admin@atsskill.com
ADMIN_PASSWORD=Admin@ATS2026
ADMIN_NAME=ATS Administrator

# Server Port
PORT=8080
