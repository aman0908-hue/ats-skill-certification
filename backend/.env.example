# ATS Skill Certification - Backend Environment Configuration Template
# NOTE: This is an example template. DO NOT put real production credentials or passwords here!
# Copy this file to .env and configure your local/production credentials securely.

# MongoDB Atlas Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/ats_skill_certification?retryWrites=true&w=majority
MONGODB_DATABASE=ats_skill_certification

# JWT Authentication Secret (Must be 32+ characters / 256 bits for HMAC-SHA256)
JWT_SECRET=your_super_secure_jwt_secret_key_at_least_256_bits_long_replace_in_production!
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# Client Application URL for CORS & QR Verification URL generation
FRONTEND_URL=https://ats-skill-certification.vercel.app,http://localhost:5173
PUBLIC_APP_URL=https://ats-skill-certification.vercel.app

# Initial Bootstrap Administrator Credentials (Use strong custom credentials)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMeStrongPassword@2026
ADMIN_NAME=System Administrator

# Server Port
PORT=8080
